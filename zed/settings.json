// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "cli_default_open_behavior": "new_window",
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "ollama",
      "model": "qwen2.5-coder:3b",
    },
    "commit_message_instructions": "Return exactly one plain-text Conventional Commit subject and nothing else. The first character of the response must be the first character of the commit type. Do not wrap the subject in backticks, quotes, a code block, or any other Markdown; the response must not contain a backtick character anywhere. Use the form type: summary. Choose the most accurate type from feat, fix, docs, style, refactor, perf, test, build, ci, chore, or revert. Prefer no scope. Only add a scope when it provides essential context; it must be one short lowercase word, never a file path or slash-separated value. Write an imperative summary focused on the user-visible intent rather than implementation details. The first word after the colon must begin with a lowercase letter. Preserve necessary capitalization in proper names and acronyms such as Alpaca and SIP. Keep the entire line at or below 72 characters. Use ! before the colon only for breaking changes. Do not add a body, explanation, prefix, suffix, quotes, or trailing period.",
    "favorite_models": [],
    "model_parameters": [],
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Solarized Light",
    "dark": "Solarized Dark",
  },
}
